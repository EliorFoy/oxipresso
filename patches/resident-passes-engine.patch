diff --git a/src/engine/engine/xetex-ini.c b/src/engine/engine/xetex-ini.c
index 092777c..3648a35 100644
--- a/src/engine/engine/xetex-ini.c
+++ b/src/engine/engine/xetex-ini.c
@@ -472,6 +472,13 @@ do_dump (char *p, size_t item_size, size_t nitems, rust_output_handle_t out_file
 static void
 do_undump (char *p, size_t item_size, size_t nitems, rust_input_handle_t in_file)
 {
+    /* OXIPRESSO: report the fmt-restore target so the embedding shim can
+     * record the complete scalar/array rewind surface (resident passes).
+     * No-op unless resident recording is active. */
+    {
+        extern void oxipresso_undump_record(const void *, size_t);
+        oxipresso_undump_record((const void *) p, item_size * nitems);
+    }
     ssize_t r = ttstub_input_read (in_file, p, item_size * nitems);
     if (r < 0 || (size_t) r != item_size * nitems)
         _tt_abort("could not undump %"PRIuZ" %"PRIuZ"-byte item(s) from %s",
@@ -3871,9 +3878,35 @@ tt_run_engine(const char *dump_name, const char *input_file_name, time_t build_d
 
     pdf_files_init();
     synctex_init_command();
+    /* OXIPRESSO (resident passes, DESIGN-resume.md option b): S0 is
+     * captured right before the FIRST start_input, i.e. post-format-load,
+     * pre-document. The pass loop below re-runs start_input + main_control
+     * from that same S0 whenever the controller commands a replay, and only
+     * falls through to the cleanup when it commands completion. Both hooks
+     * are no-ops unless resident mode was enabled by the embedding shim, so
+     * every non-resident run is byte-identical to upstream behavior. */
+    {
+        extern void oxipresso_resident_capture(void);
+        oxipresso_resident_capture();
+    }
     start_input(input_file_name);
     history = HISTORY_SPOTLESS;
     main_control();
+    /* OXIPRESSO: resident pass loop. The engine parks before every pass;
+     * the host controller either injects an edited document (restore + one
+     * more pass) or finishes (break + normal cleanup). */
+    {
+        extern int oxipresso_resident_park(void);
+        while (oxipresso_resident_park() == 1) {
+            {
+                extern void oxipresso_shipout_reset(void);
+                oxipresso_shipout_reset();
+            }
+            start_input(input_file_name);
+            history = HISTORY_SPOTLESS;
+            main_control();
+        }
+    }
     final_cleanup();
     close_files_and_terminate();
 
diff --git a/src/engine/engine/xetex-shipout.c b/src/engine/engine/xetex-shipout.c
index 47f0670..eed5674 100644
--- a/src/engine/engine/xetex-shipout.c
+++ b/src/engine/engine/xetex-shipout.c
@@ -2471,3 +2471,38 @@ dvi_pop(int32_t l)
     else
         dvi_out(POP);
 }
+
+/* OXIPRESSO (resident passes): close the DVI output and reset all
+ * shipout state so the next pass starts fresh. Without this, the
+ * shipout code reuses the pass-1 dvi_file handle whose Rust-side
+ * output_bytes entry was removed by the rollback, causing all pass-2
+ * DVI writes to silently vanish. Uses the engine's own deinit/init pair
+ * so the buffer invariants (dvi_limit = DVI_BUF_SIZE etc.) are exactly
+ * restored; hand-rolled partial resets produced a corrupted stream
+ * (8 KiB zero prefix from a broken dvi_limit). */
+void oxipresso_shipout_reset(void)
+{
+    if (dvi_file != NULL) {
+        ttstub_output_close(dvi_file);
+        dvi_file = NULL;
+    }
+    deinitialize_shipout_variables();
+    initialize_shipout_variables();
+    total_pages = 0;
+    dvi_h = 0;
+    dvi_v = 0;
+    dvi_f = 0;
+    lq = 0;
+    lr = 0;
+    /* Every font must be re-declared in the NEW DVI file. font_used[]
+     * persists across passes (heap array, not in the scalar rewind), so a
+     * pass-2 shipout would otherwise skip the fnt_def for fonts pass-1
+     * already declared, producing a DVI that references undefined fonts
+     * (measured: the cmmi12 fnt_def1 vanished, 22 bytes short). Reset the
+     * FULL array: document fonts live ABOVE the S0 font_ptr, so bounding
+     * the loop by the rewound font_ptr misses exactly the fonts that need
+     * it most. */
+    for (internal_font_number f = 0; f < font_max; f++) {
+        font_used[f] = false;
+    }
+}
